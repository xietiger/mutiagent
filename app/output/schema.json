{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentConsoleResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "summary", "category", "findings", "notes", "follow_ups"],
  "properties": {
    "schema_version": {"const": 1},
    "summary": {"type": "string", "maxLength": 4000},
    "category": {"enum": ["code", "research", "review", "data", "other"]},
    "findings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "title"],
        "properties": {
          "severity": {"enum": ["critical", "high", "medium", "low", "info"]},
          "title": {"type": "string", "maxLength": 300},
          "file": {"type": ["string", "null"], "maxLength": 500},
          "line": {"type": ["integer", "null"], "minimum": 1},
          "evidence": {"type": "string", "maxLength": 2000},
          "recommendation": {"type": "string", "maxLength": 2000},
          "confidence": {"enum": ["high", "medium", "low"]}
        }
      }
    },
    "notes": {"type": "string", "maxLength": 4000},
    "follow_ups": {
      "type": "array",
      "maxItems": 20,
      "items": {"type": "string", "maxLength": 500}
    }
  }
}
